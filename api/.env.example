# A40: this file is the only env file in the repository. Every value here is a
# placeholder — real values live in the deployment platform's environment settings
# and never in git, in logs, or on screen during the walkthrough video.

NODE_ENV=development
PORT=4000

# --- Database (A38) -----------------------------------------------------------
# 3307 matches docker-compose.yml at the repository root: the container publishes
# 3306 on host port 3307 so it cannot collide with a MySQL already installed locally.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ai_crm
DB_NAME_TEST=ai_crm_test
DB_USER=ai_crm
DB_PASSWORD=devpass
DB_SSL=false

# --- CORS ---------------------------------------------------------------------
# Origins allowed to call this API from a browser, comma separated, no trailing slash.
# Leave EMPTY in the normal deployment: the Next.js front-end proxies /api, so the
# browser never makes a cross-origin call. Only fill this in when a different origin
# genuinely needs direct access.
#   CORS_ORIGINS=https://crm.example.com,http://localhost:3000
CORS_ORIGINS=

# --- Session (A1) -------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string

# --- LINE Messaging API (A29, A36) --------------------------------------------
# LINE_ADAPTER=mock uses MockLineAdapter: no network calls, used for local dev and
# the whole test suite. Set to 'live' only where real credentials are present.
LINE_ADAPTER=mock
LINE_CHANNEL_SECRET=replace-me
LINE_CHANNEL_ACCESS_TOKEN=replace-me

# --- AI provider (A28) --------------------------------------------------------
# AI_ADAPTER=mock returns a canned bundle. Leaving the API key empty forces the
# rule-based fallback path (A25), which is how the degraded case is tested.
AI_ADAPTER=mock
AI_MODEL=claude-opus-5
AI_API_KEY=
AI_TIMEOUT_MS=15000

# --- Logging (A41) ------------------------------------------------------------
LOG_LEVEL=info

# Every API call is recorded to the rest_log table: request, response, status and
# duration, with secrets and personal fields redacted first. Set to false to turn it
# off. Rows are pruned by `npm run logs:prune` (90-day retention, A15).
REST_LOG_ENABLED=true
